# Anchored to the repo root with a leading slash. Unanchored, these Python
# packaging names match at ANY depth — `lib/` silently excluded web/lib/, so
# 13 TypeScript source files were never in git and a fresh clone could not build.
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv
ENV
env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment
# Every .env variant is ignored, not a list of the ones we thought of: a real
# `.env.bak.<timestamp>` full of live keys sat here untracked and un-ignored,
# one `git add -A` away from being published.
.env
.env.*
!.env.example
*.pem

