# ============================================
# ARTHA Terminal - Environment Configuration
# ============================================
# Copy this file to .env and fill in your API keys
# NEVER commit .env to version control

# --------------------------------------------
# AI Model Configuration (Anthropic direct + OpenRouter + Nvidia Fallback)
# --------------------------------------------

# Anthropic API — OPTIONAL, PAID (billed per-token; separate from OpenRouter
# credits and from any "anthropic/claude-*" OpenRouter slug, which is also
# billed). Leave blank to run the free stack below only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenRouter API (Primary — pick free-tier (":free" suffix) models)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
OPENROUTER_PRIMARY_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Nvidia NIM API (Last-resort fallback, also free tier)
NVIDIA_API_KEY=nvapi-your_nvidia_key
NVIDIA_FALLBACK_MODEL=qwen/qwen3-next-80b-a3b-instruct
NVIDIA_BACKUP_MODEL=meta/llama-3.3-70b-instruct

# --------------------------------------------
# Search Configuration (SerpAPI + SearxNG)
# --------------------------------------------

# SerpAPI (Primary - 250 free searches/month)
SERPAPI_KEY=your_serpapi_key

# SearxNG Self-Hosted (Fallback - unlimited when SerpAPI exhausted)
SEARXNG_URL=http://localhost:8080

# Jina AI (Optional - URL content extraction)
JINA_API_KEY=jina_your_jina_key

# --------------------------------------------
# Upstox Broker Integration (Required)
# --------------------------------------------

# Analytics Token - 1 year validity, market data only
UPSTOX_ANALYTICS_TOKEN=your_analytics_token

# Standard App Credentials - for OAuth flow
UPSTOX_CLIENT_ID=your_client_id
UPSTOX_CLIENT_SECRET=your_client_secret

# OAuth redirect URI — MUST exactly match the "Redirect URI" registered in
# your Upstox developer app (https://developer.upstox.com → your app). Points
# at the Next.js auto-callback page (web/app/upstox/callback), which reads
# ?code= and exchanges it automatically — no manual paste needed.
UPSTOX_REDIRECT_URI=http://localhost:3000/upstox/callback

# Access Token - Daily token (refreshes ~03:30 IST). Regenerate in-app via the
# portfolio page; a saved token persists to db/upstox_access_token.json.
UPSTOX_ACCESS_TOKEN=your_daily_access_token

# --------------------------------------------
# Application Settings
# --------------------------------------------

# Required for async operations
PYTHONUNBUFFERED=1

# Streamlit port
STREAMLIT_SERVER_PORT=8501

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# --------------------------------------------
# Optional: Demo Mode (For Presentations)
# --------------------------------------------

# Set to true to use frozen snapshots instead of live data
DEMO_MODE=false